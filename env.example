PORT=3000
NODE_ENV=development
DATABASE_URL=mysql://user:password@host:3306/railway
JWT_SECRET=replace-with-long-random-secret-at-least-32-characters
PUBLIC_BASE_URL=https://tu-proyecto.up.railway.app
# PayPal REST Sandbox; NEVER commit secrets
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
PAYPAL_ENABLE=false
# Number of PEN per 1 USD. Example only; set a current commercial conversion rate.
PAYPAL_PEN_PER_USD=

# Webhook ID given by PayPal Developer > App > Webhooks (different in Sandbox/Live)
PAYPAL_WEBHOOK_ID=
# Keep false until Sandbox end-to-end tests, PayPal business authorization,
# webhook signature delivery and incident handling have been validated.
PAYPAL_LIVE_RELEASE_ACK=false

# Telegram community / VIP private channel (never commit a real token)
TELEGRAM_BOT_TOKEN=
# ONLY destination for FREE picks and VIP previews. Public @username is recommended.
# A public channel URL takes precedence over a mistyped numeric ID.
TELEGRAM_FREE_CHANNEL_CHAT_ID=@FijasDeEliteOficial
TELEGRAM_FREE_CHANNEL_URL=https://t.me/FijasDeEliteOficial
# Discussion group: receives ONLY short FREE/VIP notifications (no pick details).
# Must be a Telegram group or supergroup; the bot must be allowed to send messages.
TELEGRAM_FREE_CHAT_ID=
TELEGRAM_FREE_GROUP_URL=
TELEGRAM_VIP_CHAT_ID=
# Random 32+ alphanumeric/underscore/hyphen string; used as Telegram webhook secret_token
TELEGRAM_WEBHOOK_SECRET=

# N-FORCE Football Intelligence v3.0.0: motor estadístico independiente
# `own` es el valor por defecto. No necesita FOOTBALL_API_KEY.
FOOTBALL_ENGINE_MODE=own
# Importa automáticamente los ficheros CC0 de OpenFootball cada ~12 horas.
FOOTBALL_AUTO_IMPORT=true
# Escanea los partidos guardados cada ~60 minutos; sin coste por consulta de partidos.
FOOTBALL_AUTO_SCAN=true
# Inicialmente NO publicar, hasta revisar fuente, horarios y backtesting.
FOOTBALL_AUTO_PUBLISH=false
# Segundo interruptor exclusivo v3.0 para activar publicación del motor local.
# Requiere FOOTBALL_AUTO_PUBLISH=true, backtest >=40 y canales configurados.
NFORCE_LIVE_RELEASE_ACK=false

# Verificación opcional de horarios y estados de los partidos.
# El motor sigue siendo propio (FOOTBALL_ENGINE_MODE=own), independientemente
# del verificador. Sin un feed actualizado NO se promete sincronización en vivo.
# Usa la misma clave FOOTBALL_API_KEY, sin cambiar el motor estadístico.
FOOTBALL_SCHEDULE_LIVE=false
# Límite diario de consultas del verificador (máximo 75):
FOOTBALL_SCHEDULE_MAX_CALLS=70

# Clave opcional para verificar horarios o, si eliges modo api, usar el motor heredado:
FOOTBALL_API_KEY=
# Gratis completos en comunidad; adelantos limitados VIP en público.
FOOTBALL_PUBLIC_FREE_PICKS=true
